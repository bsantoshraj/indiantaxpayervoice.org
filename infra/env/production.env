# Production: non-secret settings that differ by environment. Applied to the
# droplet's .env on every deploy (infra/staging/remote-deploy.sh). Secrets never
# go here: they are generated on each droplet. See docs/environments.md.

# Controlled release: the survey stays closed until the owner opens it with a
# reviewed pull request changing this to 1 (then promoted by the pipeline).
ITV_SURVEY_OPEN=1
# Statistics: hourly releases, counts rounded to 5, groups under 20 hidden.
ITV_AGG_INTERVAL=3600
ITV_ROUNDING=5
ITV_MIN_COHORT=20
