{
	servers {
		# Hostnames are proxied by Cloudflare: trust its edge ranges (from
		# cloudflare.com/ips-v4 and /ips-v6, fetched 2026-10-24) so the real
		# visitor IP reaches the survey's rate limiter. Refresh periodically.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Cloudflare-proxied hostnames with a Cloudflare Origin CA certificate
# (*.indiantaxpayervoice.org + apex). Cloudflare SSL mode must be "Full (strict)".
# The certificate is trusted only by Cloudflare, so these names must stay proxied.
# Key and certificate live on the droplet in var/origin-tls (never in git).
(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		-Server
	}
	encode zstd gzip
	tls /etc/caddy/origin-tls/origin.pem /etc/caddy/origin-tls/origin.key
}

# Search engines: only the production website is indexable. The survey, admin
# and statistics hosts are never indexed; staging is never indexed at all.
(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}
(robots_staging) {
	import noindex
}
(robots_production) {
	header -X-Robots-Tag
}

{$WP_HOST} {
	import security
	import robots_{$ITV_ENV}
	# Not a full script policy (WordPress uses inline scripts): blocks framing by
	# other sites, <base> hijacking, plugins, and forms posting elsewhere.
	header Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
	# WordPress files that only reveal its version.
	@wpmeta path /readme.html /license.txt /wp-config-sample.php
	respond @wpmeta 404
	# WordPress admin and login: Cloudflare Access at the edge, token re-verified
	# here by the gate (same check as the LimeSurvey admin).
	@wpadmin path /wp-admin /wp-admin/* /wp-login.php
	forward_auth @wpadmin gate:8000 {
		uri /access/check
	}
	reverse_proxy wordpress:80 {
		# Visitor IP as resolved via trusted_proxies (Cloudflare), for rate limits.
		header_up X-Real-IP {client_ip}
	}
}

# www.<website> -> https://<website> (permanent). Only production has a www DNS
# record; on staging this block is never reached.
www.{$WP_HOST} {
	import security
	import noindex
	redir https://{$WP_HOST}{uri} permanent
}

{$SURVEY_HOST} {
	import security
	import noindex
	reverse_proxy survey-proxy:8080 {
		# Visitor IP as resolved via trusted_proxies (Cloudflare), for rate limits.
		header_up X-Real-IP {client_ip}
	}
}

# LimeSurvey admin: Cloudflare Access at the edge, token re-verified by the gate.
{$SURVEY_ADMIN_HOST} {
	import security
	import noindex
	reverse_proxy survey-proxy:8090 {
		header_up X-Real-IP {client_ip}
	}
}

{$STATS_HOST} {
	import security
	import noindex
	reverse_proxy stats:8080 {
		# Visitor IP as resolved via trusted_proxies (Cloudflare), for rate limits.
		header_up X-Real-IP {client_ip}
	}
}
