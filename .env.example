# Copy is generated by scripts/init-local-env.sh with random values.
# Placeholders only — never put real values in this file.

COMPOSE_PROJECT_NAME=itv
# Local: run the two MariaDB containers. Staging: leave unset (DB on the host).
COMPOSE_PROFILES=localdb

# local | staging | production (staging and production run on DigitalOcean)
ITV_ENV=local

# Interface to publish ports on. 127.0.0.1 = this machine only;
# 0.0.0.0 = all interfaces (LAN-reachable, plain HTTP — local testing only).
BIND_ADDR=127.0.0.1
# Published ports
WP_PORT=8080
LS_PORT=8081
# HTTPS port for the survey (the bot check needs HTTPS). See scripts/make-local-certs.sh.
LS_TLS_PORT=8443
# LimeSurvey admin (local: open; staging/production: Cloudflare Access only)
LS_ADMIN_PORT=8083
STATS_PORT=8082

# WordPress database (WordPress only; holds no survey data)
# Staging: host.docker.internal (MariaDB on the droplet host)
WP_DB_HOST=wp-db
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=<generated>
WP_DB_ROOT_PASSWORD=<generated>
WP_ADMIN_USER=itv-admin
WP_ADMIN_PASSWORD=<generated>
WP_ADMIN_EMAIL=hello@indiantaxpayervoice.org
WP_URL=http://localhost:8080

# LimeSurvey database (survey responses; separate server from WordPress)
# Staging: host.docker.internal (MariaDB on the droplet host)
LS_DB_HOST=ls-db
LS_DB_NAME=limesurvey
LS_DB_USER=limesurvey
LS_DB_PASSWORD=<generated>
LS_DB_ROOT_PASSWORD=<generated>
LS_ADMIN_USER=ls-admin
LS_ADMIN_PASSWORD=<generated>
LS_ADMIN_EMAIL=hello@indiantaxpayervoice.org
LS_PUBLIC_URL=http://localhost:8081

# LimeSurvey data-encryption keys (hex, libsodium). Must be identical on every
# replica and backed up separately from the database: losing them makes
# encrypted response fields unreadable.
LS_ENCRYPT_KEYPAIR=<generated>
LS_ENCRYPT_PUBLIC_KEY=<generated>
LS_ENCRYPT_SECRET_KEY=<generated>
LS_ENCRYPT_NONCE=<generated>
LS_ENCRYPT_SECRET_BOX_KEY=<generated>

# Aggregator: dedicated LimeSurvey account with export permission on one survey
ITV_LS_SURVEY_ID=<set after creating the survey>
ITV_LS_USER=stats-exporter
ITV_LS_PASSWORD=<generated>
ITV_MIN_COHORT=20

# Survey gate (bot challenge). Always enabled in staging/production (the gate
# refuses to start otherwise). Locally it may be disabled for easier testing;
# enabling it locally requires HTTPS on LS_TLS_PORT (scripts/make-local-certs.sh).
ITV_GATE_ENABLED=0
ITV_GATE_SECURE_COOKIE=0
# Turnstile is optional: leave blank to use ALTCHA only.
ITV_GATE_SECRET=<generated>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Cloudflare Access for the LimeSurvey admin (not secret; set by the staging deploy
# from infra/terraform/cloudflare outputs). Empty locally: the admin is open there.
ITV_ACCESS_TEAM_DOMAIN=
ITV_ACCESS_AUD=
ITV_ACCESS_ALLOWED_EMAILS=
